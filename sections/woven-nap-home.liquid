<section
  class="wn-home"
  style="
    --wn-hero-image: url('{{ hero_image_url }}');
    --wn-hero-mobile-image: url('{{ hero_mobile_image_url }}');
    --wn-before-image: url('{{ before_image_url }}');
    --wn-after-image: url('{{ after_image_url }}');
  "
>
  <div class="wn-hero">
    <div class="wn-shell">
      <div class="wn-hero__content">
        <h1 class="wn-heading wn-hero__heading-desktop">{{ section.settings.hero_heading | escape }}</h1>
        <h1 class="wn-heading wn-hero__heading-mobile">Stay Close. Sleep Better.</h1>
        <p>{{ section.settings.hero_text | escape }}</p>
        <div class="wn-actions">
          <a class="wn-button wn-button--primary" href="{{ primary_link }}" tabindex="-1" aria-hidden="true">{{ section.settings.primary_button_label | escape }}</a>
          <a class="wn-button" href="{{ secondary_link }}" tabindex="-1" aria-hidden="true">{{ section.settings.secondary_button_label | escape }}</a>
        </div>
      </div>
    </div>
    <a class="wn-hero__image-cta" href="{{ primary_link }}" aria-label="{{ section.settings.primary_button_label | escape }}">
      {{ section.settings.primary_button_label | escape }} <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <div class="wn-compare" aria-label="Basket comparison">
    <div class="wn-compare__panel" style="background-image: var(--wn-before-image);">
      <div class="wn-compare__label">
        <strong>Before</strong>
        <span>Cluttered. Uncomfortable.</span>
      </div>
    </div>
    <div class="wn-compare__panel wn-compare__panel--after" style="background-image: var(--wn-after-image);">
      <div class="wn-compare__label">
        <strong>After</strong>
        <span>Beautiful. Breathable. Belonged.</span>
      </div>
    </div>
    <span class="wn-compare__handle" aria-hidden="true">&lsaquo; &rsaquo;</span>
    <input class="wn-compare__range" type="range" min="5" max="95" value="50" aria-label="Slide to compare before and after">
  </div>

  <div class="wn-shell">
    <div class="wn-benefits">
      <article class="wn-benefit">
        <span class="wn-benefit__icon" aria-hidden="true">
          <svg viewBox="0 0 64 64"><path d="M7 22c11 8 21-8 32 0 7 5 12 3 18-2"/><path d="M7 34c11 8 21-8 32 0 7 5 12 3 18-2"/><path d="M7 46c11 8 21-8 32 0 7 5 12 3 18-2"/></svg>
        </span>
        <h3>Air-Flow Tech</h3>
        <p>Natural weave for year-round breathability.</p>
      </article>
      <article class="wn-benefit">
        <span class="wn-benefit__icon" aria-hidden="true">
          <svg viewBox="0 0 64 64"><path d="M19 23h26l5 29H14l5-29Z"/><path d="M24 23v-5a8 8 0 0 1 16 0v5"/></svg>
        </span>
        <h3>Move With You</h3>
        <p>Lightweight design with integrated handles.</p>
      </article>
      <article class="wn-benefit">
        <span class="wn-benefit__icon" aria-hidden="true">
          <svg viewBox="0 0 64 64"><rect x="15" y="9" width="34" height="46" rx="3"/><path d="M21 17h4M29 17h4M37 17h6"/><circle cx="32" cy="37" r="12"/><path d="M39 31a9 9 0 0 1-7 15"/></svg>
        </span>
        <h3>Easy Refresh</h3>
        <p>Easy-clean basket with a washable insert.</p>
      </article>
      <article class="wn-benefit">
        <span class="wn-benefit__icon" aria-hidden="true">
          <svg viewBox="0 0 64 64"><path d="M17 34h30a8 8 0 0 1 8 8v8H9v-8a8 8 0 0 1 8-8Z"/><path d="M17 34v-9a8 8 0 0 1 8-8h14a8 8 0 0 1 8 8v9"/><path d="M15 50v7M49 50v7M9 42H4M60 42h-5"/></svg>
        </span>
        <h3>Home Decor</h3>
        <p>Blends seamlessly into your living space.</p>
      </article>
      <article class="wn-benefit">
        <span class="wn-benefit__icon" aria-hidden="true">
          <svg viewBox="0 0 64 64"><path d="M8 20h31v24H8z"/><path d="M39 28h9l8 8v8H39z"/><path d="M17 48a5 5 0 1 0 0-10 5 5 0 0 0 0 10ZM47 48a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z"/><path d="M8 38h4M39 38h3"/></svg>
        </span>
        <h3>Free Shipping</h3>
        <p>Free shipping on orders over $75.</p>
      </article>
    </div>

    <div class="wn-materials">
      <div class="wn-materials__head">
        <h2 class="wn-heading">Shop by Material</h2>
        <p>Use natural woven for a warm furniture feel, or PP woven when washability is the top priority.</p>
      </div>
      <div class="wn-material-grid">
        <a class="wn-material" href="{{ primary_link }}" aria-label="Shop Natural Woven cat baskets">
          <img src="{{ 'product-main-v3-01.jpg' | asset_url }}" alt="Natural woven cat basket in use" width="1080" height="1080" loading="lazy">
          <span class="wn-material__body">
            <strong>Natural Woven</strong>
            <span>Rattan, bamboo and willow baskets for breathable naps.</span>
          </span>
        </a>
        <a class="wn-material" href="{{ primary_link }}" aria-label="Shop PP Woven cat baskets">
          <img src="{{ 'product-main-v3-02.jpg' | asset_url }}" alt="PP woven cat bed with cooling mat" width="1080" height="1080" loading="lazy">
          <span class="wn-material__body">
            <strong>PP Woven</strong>
            <span>Lightweight washable styles for summer and daily refresh.</span>
          </span>
        </a>
      </div>
    </div>

    <div class="wn-shop-area">
      <div>
        <div class="wn-products">
          <div class="wn-row-title">
            <h2 class="wn-heading">{{ section.settings.collection_heading | escape }}</h2>
            <a class="wn-view" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">View all &rarr;</a>
          </div>
          <div class="wn-product-grid">
            {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
              {%- for product in featured_collection.products limit: 5 -%}
                <article class="wn-product">
                  <a class="wn-product__image" href="{{ product.url }}">
                    {%- if product.featured_image != blank -%}
                      {{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
                    {%- elsif section.settings.product_card_image != blank -%}
                      {{ section.settings.product_card_image | image_url: width: 640 | image_tag: loading: 'lazy', alt: product.title }}
                    {%- else -%}
                      <img src="{{ 'woven-nap-product.png' | asset_url }}" alt="{{ product.title | escape }}" width="520" height="398" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div class="wn-product__body">
                    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                    {%- liquid
                      assign sale_price = product.price
                      assign original_price = product.compare_at_price_max
                      if original_price == blank or original_price <= sale_price
                        assign original_price = sale_price | times: 1.25 | round
                      endif
                    -%}
                    <p class="wn-product__price">
                      <s class="wn-product__price-original">{{ original_price | money }}</s>
                      <span class="wn-product__price-sale">{{ sale_price | money }}</span>
                    </p>
                    <p class="wn-product__meta">For cats up to 20 lbs</p>
                  </div>
                </article>
              {%- endfor -%}
            {%- else -%}
              {%- assign fallback_titles = 'Breathable Woven Cat Nap Basket|Washable PP Woven Cat Bed|Portable Woven Cat Carry Basket|Cool Bamboo Cat Villa Basket Bed|Open-Top PP Woven Cat Lounger Tray' | split: '|' -%}
              {%- assign fallback_original_prices = '$79.00|$99.00|$99.00|$89.00|$65.00' | split: '|' -%}
              {%- assign fallback_sale_prices = '$59.00|$77.00|$79.00|$69.00|$49.00' | split: '|' -%}
              {%- assign fallback_meta = 'Natural Woven · Up to 12 lbs|PP Woven · Cooling Mat|Natural Woven · Portable|Natural Woven · Up to 20 lbs|PP Woven · Easy Wash' | split: '|' -%}
              {%- for title in fallback_titles -%}
                <article class="wn-product">
                  <a class="wn-product__image" href="{{ routes.all_products_collection_url }}">
                    {%- if section.settings.product_card_image != blank -%}
                      {{ section.settings.product_card_image | image_url: width: 640 | image_tag: loading: 'lazy', alt: title }}
                    {%- else -%}
                      <img src="{{ fallback_product_images[forloop.index0] | asset_url }}" alt="{{ title | escape }}" width="640" height="640" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div class="wn-product__body">
                    <h3><a href="{{ routes.all_products_collection_url }}">{{ title }}</a></h3>
                    <p class="wn-product__price">
                      <s class="wn-product__price-original">{{ fallback_original_prices[forloop.index0] }}</s>
                      <span class="wn-product__price-sale">{{ fallback_sale_prices[forloop.index0] }}</span>
                    </p>
                    <p class="wn-product__meta">{{ fallback_meta[forloop.index0] }}</p>
                  </div>
                </article>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

