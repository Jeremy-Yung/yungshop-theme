{%- liquid
  assign hero_image_url = 'woven-nap-hero-desktop.png' | asset_url
  if section.settings.hero_image != blank
    assign hero_image_url = section.settings.hero_image | image_url: width: 2200
  endif

  assign hero_mobile_image_url = 'woven-nap-hero-mobile.png' | asset_url
  if section.settings.hero_mobile_image != blank
    assign hero_mobile_image_url = section.settings.hero_mobile_image | image_url: width: 1200
  endif

  assign before_image_url = 'woven-nap-before.png' | asset_url
  if section.settings.before_image != blank
    assign before_image_url = section.settings.before_image | image_url: width: 1200
  endif

  assign after_image_url = 'woven-nap-after.png' | asset_url
  if section.settings.after_image != blank
    assign after_image_url = section.settings.after_image | image_url: width: 1200
  endif

  assign fallback_product_images = 'product-main-v3-01.jpg|product-main-v3-02.jpg|product-main-v3-03.jpg|product-main-v3-04.jpg|product-main-v3-05.jpg' | split: '|'

  assign featured_collection = section.settings.collection
  assign selected_product = section.settings.featured_product
  if selected_product != blank and selected_product.selected_or_first_available_variant != blank
    assign selected_variant = selected_product.selected_or_first_available_variant
  endif
  assign basket_price_cents = 5900
  if selected_variant != blank
    assign basket_price_cents = selected_variant.price
  endif
  assign primary_link = section.settings.primary_button_link | default: routes.all_products_collection_url
  assign secondary_link = section.settings.secondary_button_link | default: routes.all_products_collection_url
-%}

<style>
  #shopify-section-{{ section.id }} {
    --wn-ink: #20241f;
    --wn-muted: #5f6257;
    --wn-green: #596a37;
    --wn-green-dark: #435227;
    --wn-line: #ded7cb;
    --wn-paper: #fbf8f2;
    --wn-cream: #f4efe6;
    --wn-wicker: #b5844c;
    --wn-shadow: 0 18px 48px rgba(46, 40, 30, 0.12);
    color: var(--wn-ink);
    background: var(--wn-paper);
  }

  #shopify-section-{{ section.id }} .wn-home {
    font-family: var(--font-body-family);
    background: linear-gradient(180deg, #fbf8f2 0%, #f5efe4 100%);
  }

  .section-header .header-wrapper,
  .announcement-bar-section .utility-bar {
    background: #f4efe7;
    color: #20241f;
  }

  .section-header .header {
    max-width: none;
  }

  .section-header .header__heading .h2 {
    font-family: Georgia, "Times New Roman", serif;
    color: #7a4f2a;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .announcement-bar-section .announcement-bar__message {
    min-height: 30px;
    padding: 8px 0;
    color: #20241f;
    font-size: 13px;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .wn-shell {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 0 36px;
  }

  #shopify-section-{{ section.id }} .wn-heading {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--wn-ink);
  }

  #shopify-section-{{ section.id }} .wn-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--wn-green);
    border-radius: 4px;
    padding: 0 28px;
    color: var(--wn-green-dark);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  #shopify-section-{{ section.id }} .wn-button:hover {
    transform: translateY(-1px);
  }

  #shopify-section-{{ section.id }} .wn-button--primary {
    background: var(--wn-green);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .wn-button--primary:hover {
    background: var(--wn-green-dark);
  }

  #shopify-section-{{ section.id }} .wn-hero {
    position: relative;
    min-height: 520px;
    aspect-ratio: 1672 / 941;
    background-image: var(--wn-hero-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-bottom: 1px solid var(--wn-line);
  }

  #shopify-section-{{ section.id }} .wn-hero__content {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #shopify-section-{{ section.id }} .wn-hero h1 {
    margin: 0 0 24px;
    font-size: clamp(45px, 5.8vw, 76px);
    line-height: 0.96;
  }

  #shopify-section-{{ section.id }} .wn-hero__heading-mobile {
    display: none;
  }

  #shopify-section-{{ section.id }} .wn-hero p {
    max-width: 430px;
    margin: 0 0 28px;
    color: #353930;
    font-size: 19px;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .wn-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .wn-hero__image-cta {
    position: absolute;
    left: 5.98%;
    top: 63.65%;
    z-index: 2;
    width: 12.92%;
    height: 5.95%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border-radius: 12px;
    background: linear-gradient(135deg, #e7a05f 0%, #d98648 100%);
    box-shadow: 0 12px 24px rgba(102, 61, 28, 0.18);
    color: #fff;
    font-size: clamp(14px, 1.25vw, 20px);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  #shopify-section-{{ section.id }} .wn-hero__image-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 16px 28px rgba(102, 61, 28, 0.24);
  }

  #shopify-section-{{ section.id }} .wn-hero__image-cta:focus-visible {
    outline: 3px solid rgba(89, 106, 55, 0.95);
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .wn-compare {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border-bottom: 1px solid var(--wn-line);
  }

  #shopify-section-{{ section.id }} .wn-compare__panel {
    position: relative;
    min-height: clamp(220px, 25vw, 330px);
    background-size: cover;
    background-position: center;
  }

  #shopify-section-{{ section.id }} .wn-compare__panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 46%, rgba(0, 0, 0, 0.38));
  }

  #shopify-section-{{ section.id }} .wn-compare__label {
    position: absolute;
    z-index: 1;
    left: 28px;
    bottom: 22px;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .wn-compare__panel--after .wn-compare__label {
    right: 28px;
    left: auto;
    text-align: right;
  }

  #shopify-section-{{ section.id }} .wn-compare__label strong {
    display: block;
    font-size: 21px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .wn-compare__label span {
    display: block;
    margin-top: 4px;
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .wn-compare__handle {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: grid;
    width: 54px;
    height: 54px;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    transform: translate(-50%, -50%);
    font-weight: 800;
    color: var(--wn-ink);
  }

  #shopify-section-{{ section.id }} .wn-compare__range {
    display: none;
  }

  #shopify-section-{{ section.id }} .wn-benefits {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    padding: 34px 0 38px;
  }

  #shopify-section-{{ section.id }} .wn-benefit {
    min-height: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 26px;
    text-align: center;
    border-left: 1px solid var(--wn-line);
  }

  #shopify-section-{{ section.id }} .wn-benefit:first-child {
    border-left: 0;
  }

  #shopify-section-{{ section.id }} .wn-benefit__icon {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    margin-bottom: 14px;
    color: var(--wn-green);
  }

  #shopify-section-{{ section.id }} .wn-benefit__icon svg {
    width: 54px;
    height: 54px;
    stroke: currentColor;
    stroke-width: 1.55;
    fill: none;
  }

  #shopify-section-{{ section.id }} .wn-benefit h3 {
    margin: 0 0 9px;
    font-size: 17px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .wn-benefit p {
    margin: 0;
    color: #353930;
    font-size: 14px;
    line-height: 1.38;
  }

  #shopify-section-{{ section.id }} .wn-materials {
    padding: 0 0 34px;
  }

  #shopify-section-{{ section.id }} .wn-materials__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .wn-materials__head h2 {
    margin: 0;
    font-size: 30px;
    line-height: 1.12;
  }

  #shopify-section-{{ section.id }} .wn-materials__head p {
    max-width: 420px;
    margin: 0;
    color: var(--wn-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .wn-material-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .wn-material {
    position: relative;
    min-height: 238px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border: 1px solid var(--wn-line);
    border-radius: 8px;
    background: #f5eee2;
    color: #fff;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .wn-material img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  #shopify-section-{{ section.id }} .wn-material:hover img {
    transform: scale(1.025);
  }

  #shopify-section-{{ section.id }} .wn-material::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(32, 36, 31, 0.02) 28%, rgba(32, 36, 31, 0.66) 100%);
  }

  #shopify-section-{{ section.id }} .wn-material__body {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 20px;
  }

  #shopify-section-{{ section.id }} .wn-material strong,
  #shopify-section-{{ section.id }} .wn-material span {
    display: block;
  }

  #shopify-section-{{ section.id }} .wn-material strong {
    font-size: 24px;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .wn-material span {
    max-width: 310px;
    margin-top: 7px;
    font-size: 13px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .wn-shop-area {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding: 0 0 56px;
  }

  #shopify-section-{{ section.id }} .wn-card {
    border: 1px solid var(--wn-line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--wn-shadow);
    backdrop-filter: blur(12px);
  }

  #shopify-section-{{ section.id }} .wn-size h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .wn-products {
    padding: 24px 20px 0;
  }

  #shopify-section-{{ section.id }} .wn-row-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .wn-row-title h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .wn-view {
    color: var(--wn-ink);
    font-size: 14px;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .wn-product-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .wn-product {
    overflow: hidden;
    border: 1px solid #eee6da;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.64);
  }

  #shopify-section-{{ section.id }} .wn-product__image {
    display: block;
    aspect-ratio: 1.28 / 1;
    padding: 10px;
    background: #f5eee2;
  }

  #shopify-section-{{ section.id }} .wn-product__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #shopify-section-{{ section.id }} .wn-product__body {
    padding: 14px 16px 18px;
  }

  #shopify-section-{{ section.id }} .wn-product h3 {
    margin: 0 0 5px;
    font-size: 15px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .wn-product a {
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .wn-product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .wn-product__price-original {
    color: #8c867a;
    font-size: 0.88em;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .wn-product__price-sale {
    color: #9d5525;
    font-size: 1.08em;
  }

  #shopify-section-{{ section.id }} .wn-product__meta {
    margin: 0;
    color: var(--wn-muted);
    font-size: 12px;
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .wn-lower {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 28px;
    align-items: start;
    padding: 0 0 70px;
  }

  #shopify-section-{{ section.id }} .wn-why {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    padding: 22px 20px 0;
    border-top: 1px solid var(--wn-line);
  }

  #shopify-section-{{ section.id }} .wn-why h2 {
    margin: 0 0 12px;
    font-size: 31px;
    line-height: 1.12;
  }

  #shopify-section-{{ section.id }} .wn-why p {
    margin: 0 0 14px;
    color: var(--wn-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .wn-table {
    width: 100%;
    border-collapse: collapse;
    overflow: hidden;
    border: 1px solid var(--wn-line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.52);
    font-size: 13px;
  }

  #shopify-section-{{ section.id }} .wn-table th,
  #shopify-section-{{ section.id }} .wn-table td {
    padding: 12px 10px;
    border-left: 1px solid var(--wn-line);
    border-top: 1px solid var(--wn-line);
    text-align: center;
    vertical-align: middle;
  }

  #shopify-section-{{ section.id }} .wn-table tr:first-child th {
    border-top: 0;
  }

  #shopify-section-{{ section.id }} .wn-table th:first-child,
  #shopify-section-{{ section.id }} .wn-table td:first-child {
    border-left: 0;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .wn-table .is-best {
    background: rgba(89, 106, 55, 0.11);
    color: var(--wn-green-dark);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .wn-dots {
    white-space: nowrap;
    letter-spacing: 0;
    color: #60665a;
  }

  #shopify-section-{{ section.id }} .wn-dots--best {
    color: var(--wn-green);
  }

  #shopify-section-{{ section.id }} .wn-size {
    padding: 22px;
  }

  #shopify-section-{{ section.id }} .wn-size__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .wn-size-card {
    border: 1px solid var(--wn-line);
    border-radius: 8px;
    padding: 13px;
    background: rgba(255, 255, 255, 0.64);
  }

  #shopify-section-{{ section.id }} .wn-size-card__badge {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    margin-bottom: 6px;
    border: 1px solid var(--wn-green);
    border-radius: 50%;
    color: var(--wn-green);
    font-size: 20px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .wn-size-card p {
    margin: 0 0 10px;
    color: var(--wn-muted);
    font-size: 12px;
  }

  #shopify-section-{{ section.id }} .wn-cat-line {
    height: 80px;
    margin: 0 0 10px;
    border: 1px solid #b8aa93;
    border-radius: 999px 999px 28px 28px;
    background:
      radial-gradient(circle at 36% 42%, transparent 0 11px, #596a37 12px, transparent 13px),
      radial-gradient(circle at 65% 42%, transparent 0 11px, #596a37 12px, transparent 13px),
      linear-gradient(180deg, rgba(255,255,255,0) 54%, rgba(89,106,55,0.13) 55%);
  }

  #shopify-section-{{ section.id }} .wn-tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  #shopify-section-{{ section.id }} .wn-tags span {
    display: flex;
    min-height: 31px;
    align-items: center;
    justify-content: center;
    border: 1px solid #b9ad97;
    border-radius: 4px;
    color: var(--wn-green-dark);
    font-size: 11px;
    line-height: 1.2;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .wn-size .wn-button {
    width: 100%;
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .wn-breed-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 2px;
  }

  #shopify-section-{{ section.id }} .wn-breed {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    gap: 6px;
    border: 1px solid #c9bda8;
    border-radius: 999px;
    padding: 0 10px;
    color: var(--wn-green-dark);
    font-size: 12px;
    line-height: 1;
    background: #fffaf2;
  }

  #shopify-section-{{ section.id }} .wn-size-quiz {
    margin-top: 16px;
    padding: 14px;
    border: 1px solid #d8ceb9;
    border-radius: 8px;
    background: #fffaf2;
  }

  #shopify-section-{{ section.id }} .wn-size-quiz strong {
    display: block;
    margin-bottom: 10px;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .wn-size-quiz__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .wn-size-quiz input {
    width: 100%;
    min-height: 42px;
    border: 1px solid #c9bda8;
    border-radius: 4px;
    padding: 0 12px;
    background: #fff;
    color: var(--wn-ink);
    font: inherit;
  }

  #shopify-section-{{ section.id }} .wn-size-quiz button {
    min-height: 42px;
    border: 1px solid var(--wn-green);
    border-radius: 4px;
    padding: 0 13px;
    background: var(--wn-green);
    color: #fff;
    font: inherit;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .wn-size-quiz__result {
    margin: 10px 0 0;
    color: var(--wn-green-dark);
    font-size: 13px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .wn-trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .wn-trust__item {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--wn-line);
    border-radius: 8px;
    padding: 8px;
    background: rgba(255, 255, 255, 0.62);
    color: var(--wn-green-dark);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .wn-sticky-cart {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .announcement-bar-section .announcement-bar__message {
      min-height: 28px;
      padding: 7px 16px;
      font-size: 12px;
      line-height: 1.25;
    }

    .section-header .header {
      padding-left: 18px;
      padding-right: 18px;
    }

    .section-header .header__heading .h2 {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .wn-shell {
      padding: 0 18px;
    }

    #shopify-section-{{ section.id }} .wn-hero {
      min-height: 0;
      background-image: var(--wn-hero-image);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    #shopify-section-{{ section.id }} .wn-hero__content {
      width: 1px;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .wn-hero h1 {
      max-width: 520px;
      margin-bottom: 14px;
      font-size: 44px;
      line-height: 1.02;
    }

    #shopify-section-{{ section.id }} .wn-hero p {
      max-width: 520px;
      margin-bottom: 22px;
      font-size: 16px;
      line-height: 1.45;
    }

