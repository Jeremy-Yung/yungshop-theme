<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const compare = section.querySelector('.wn-compare');
    const range = section.querySelector('.wn-compare__range');
    if (compare && range) {
      const updateCompare = () => {
        compare.style.setProperty('--compare-position', `${range.value}%`);
      };
      range.addEventListener('input', updateCompare);
      updateCompare();
    }

    const quiz = section.querySelector('[data-size-quiz]');
    if (quiz) {
      const input = quiz.querySelector('[data-size-input]');
      const button = quiz.querySelector('[data-size-button]');
      const result = quiz.querySelector('[data-size-result]');
      const recommend = () => {
        const weight = Number(input.value || 0);
        if (!weight) {
          result.textContent = 'Enter weight to get a size recommendation.';
        } else if (weight <= 12) {
          result.textContent = 'Recommended size: M. Best for cats up to 12 lbs.';
        } else if (weight <= 20) {
          result.textContent = 'Recommended size: L. Best for cats up to 20 lbs.';
        } else {
          result.textContent = 'Recommended size: L High Sides for extra room.';
        }
      };
      button.addEventListener('click', recommend);
      input.addEventListener('input', recommend);
    }

    const sticky = section.querySelector('[data-sticky-cart]');
    const products = section.querySelector('.wn-products');
    if (sticky && products) {
      const updateSticky = () => {
        const start = products.getBoundingClientRect().top + window.scrollY - 80;
        const shouldShow = window.innerWidth < 750 && window.scrollY > start;
        sticky.classList.toggle('is-visible', shouldShow);
      };
      window.addEventListener('scroll', updateSticky, { passive: true });
      window.addEventListener('resize', updateSticky);
      updateSticky();
    }
  })();
</script>

